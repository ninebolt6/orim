{
  "name": "@orim/core",
  "version": "0.1.0",
  "description": "A small, dependency-free DOCX renderer for the browser",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./style.css": "./src/render/styles.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./style.css": "./dist/style.css"
    }
  },
  "scripts": {
    "build": "vp pack && node ../../scripts/copy-core-style.mjs"
  }
}
