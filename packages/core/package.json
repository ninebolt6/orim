{
  "name": "@orim/core",
  "version": "0.1.0",
  "description": "Small, dependency-free DOCX and XLSX viewers for the browser",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./docx.css": "./src/docx/render/styles.css",
    "./xlsx.css": "./src/xlsx/render/styles.css",
    "./pptx.css": "./src/pptx/render/styles.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./docx.css": "./dist/docx.css",
      "./xlsx.css": "./dist/xlsx.css",
      "./pptx.css": "./dist/pptx.css"
    }
  },
  "scripts": {
    "build": "vp pack && node ../../scripts/copy-core-style.mjs"
  }
}
