{
  "name": "orim-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Small, dependency-free DOCX and XLSX viewers for the browser",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "typecheck": "pnpm exec tsc --noEmit -p packages/core/tsconfig.json && pnpm exec tsc --noEmit -p packages/react/tsconfig.json && pnpm exec tsc --noEmit -p apps/demo/tsconfig.json",
    "size": "node scripts/size.mjs",
    "fixtures": "node scripts/make-docx-fixture.mjs && node scripts/make-xlsx-fixture.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "fflate": "^0.8.3",
    "happy-dom": "^20.14.6",
    "playwright": "^1.58.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.1.0"
  },
  "packageManager": "pnpm@11.21.0"
}
